# 复制为 .env 后填写真实值（.env 不会提交到 Git）
JWT_SECRET=请替换为随机长字符串
SILICONFLOW_API_KEY=你的硅基流动 API Key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 163 邮箱：EMAIL_USER 填完整邮箱地址，EMAIL_PASS 填 SMTP 授权码（不是登录密码）
EMAIL_USER=your@163.com
EMAIL_PASS=你的SMTP授权码

PORT=3000

# 超管后台账号（ADMIN_PASSWORD_HASH 用 bcrypt 生成，不要填明文密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$替换成你自己的bcrypt哈希

# 每个用户每天最多发送多少条 AI 消息
CHAT_DAILY_LIMIT=50
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
